    ("NIDS-011", "Known Trojan Port",    "HIGH",
     "Traffic on ports associated with known trojans/backdoors.",
     lambda p: TCP in p and p[TCP].dport in {1234, 4444, 5555, 6666, 31337, 12345}),

    ("NIDS-012", "Large ICMP Packet",    "MEDIUM",
