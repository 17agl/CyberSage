R="\033[91m"; G="\033[92m"; Y="\033[93m"; B="\033[94m"
M="\033[95m"; C="\033[96m"; BOLD="\033[1m"; X="\033[0m"

BANNER = f"""{R}{BOLD}
 ███╗  ██╗██╗██████╗ ███████╗
