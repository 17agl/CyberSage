]

# ─────────────────────────────────────────────────────────────────────────────
# STATE / STATS
# ─────────────────────────────────────────────────────────────────────────────
stats = {
    "total_packets": 0,
    "alerts": 0,
    "by_severity": defaultdict(int),
    "by_rule": defaultdict(int),
    "src_ips": defaultdict(int),
}
alerts_log: list[dict] = []
# Throttle: don't fire same rule+src more than once per 10 s
_throttle: dict[str, float] = {}
THROTTLE_SEC = 10
lock = threading.Lock()


def throttle_key(rule_id, src_ip): return f"{rule_id}:{src_ip}"

def should_fire(rule_id, src_ip) -> bool:
    key = throttle_key(rule_id, src_ip)
    now = time.time()
    with lock:
        last = _throttle.get(key, 0)
        if now - last < THROTTLE_SEC:
            return False
        _throttle[key] = now
    return True

# ─────────────────────────────────────────────────────────────────────────────
# ALERT ENGINE
# ─────────────────────────────────────────────────────────────────────────────
log_file: str = "nids_alerts.log"

def fire_alert(rule_id, name, severity, description, pkt):
    src = pkt[IP].src if IP in pkt else "?"
    dst = pkt[IP].dst if IP in pkt else "?"
    proto = "TCP" if TCP in pkt else "UDP" if UDP in pkt else "ICMP" if ICMP in pkt else "OTHER"
    sport = pkt[TCP].sport if TCP in pkt else (pkt[UDP].sport if UDP in pkt else 0)
    dport = pkt[TCP].dport if TCP in pkt else (pkt[UDP].dport if UDP in pkt else 0)
    ts    = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    if not should_fire(rule_id, src):
        return   # throttled

    col = SEV[severity]
    icon = SEV_ICON[severity]

    # Console
    print(f"\n{col}{BOLD}{'!'*60}{X}")
    print(f"{col}{BOLD}{icon} ALERT [{rule_id}] {name}  —  {severity}{X}")
    print(f"  {Y}Time    :{X} {ts}")
    print(f"  {Y}Src     :{X} {C}{src}:{sport}{X}")
    print(f"  {Y}Dst     :{X} {C}{dst}:{dport}{X}")
    print(f"  {Y}Proto   :{X} {proto}")
    print(f"  {Y}Detail  :{X} {description}")
    print(f"{col}{'!'*60}{X}")

    # Update stats
    with lock:
        stats["alerts"] += 1
        stats["by_severity"][severity] += 1
        stats["by_rule"][rule_id] += 1
        stats["src_ips"][src] += 1

    # Log entry
    entry = {
        "timestamp": ts, "rule_id": rule_id, "name": name,
        "severity": severity, "src": f"{src}:{sport}",
        "dst": f"{dst}:{dport}", "proto": proto,
    }
    with lock:
        alerts_log.append(entry)
    with open(log_file, "a") as f:
        f.write(json.dumps(entry) + "\n")

# ─────────────────────────────────────────────────────────────────────────────
# ANOMALY DETECTOR  (SYN flood / port scan detection via per-IP counters)
# ─────────────────────────────────────────────────────────────────────────────
_syn_counts: dict[str, list[float]] = defaultdict(list)
SYN_THRESHOLD  = 20   # SYNs per 5 seconds from one IP = port scan
SYN_WINDOW     = 5.0

def check_syn_flood(pkt):
    if TCP not in pkt or IP not in pkt: return
    if "S" not in pkt[TCP].sprintf("%TCP.flags%"): return
    src = pkt[IP].src
    now = time.time()
    with lock:
        _syn_counts[src] = [t for t in _syn_counts[src] if now - t < SYN_WINDOW]
        _syn_counts[src].append(now)
        count = len(_syn_counts[src])

    if count == SYN_THRESHOLD:   # fire once at threshold crossing
        col = SEV["HIGH"]
        ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        print(f"\n{col}{BOLD}{'!'*60}{X}")
        print(f"{col}{BOLD}🟠 ANOMALY ALERT — SYN Flood / Port Scan  (NIDS-ANOMALY){X}")
        print(f"  {Y}Source IP:{X} {C}{src}{X}")
        print(f"  {Y}SYNs sent:{X} {count} in {SYN_WINDOW}s → threshold exceeded!")
        print(f"  {Y}Time     :{X} {ts}")
        print(f"  {Y}Action   :{X} Monitor or block {src} at firewall")
        print(f"{col}{'!'*60}{X}")
        entry = {"timestamp": ts, "rule_id": "NIDS-ANOMALY", "name": "SYN Flood/Port Scan",
                 "severity": "HIGH", "src": src, "dst": "multiple", "proto": "TCP"}
        with lock:
            stats["alerts"] += 1
            stats["by_severity"]["HIGH"] += 1
            alerts_log.append(entry)
        with open(log_file, "a") as f:
            f.write(json.dumps(entry) + "\n")

# ─────────────────────────────────────────────────────────────────────────────
# PACKET HANDLER
# ─────────────────────────────────────────────────────────────────────────────
def packet_handler(pkt):
    with lock:
        stats["total_packets"] += 1
    n = stats["total_packets"]
    if n % 100 == 0:
        print(f"{C}[*] Packets analysed: {n}  |  Alerts: {stats['alerts']}{X}", end="\r")

    check_syn_flood(pkt)

    for rule_id, name, severity, description, check_fn in RULES:
        try:
            if check_fn(pkt):
                fire_alert(rule_id, name, severity, description, pkt)
        except Exception:
            pass   # Silently ignore parse errors on malformed packets

# ─────────────────────────────────────────────────────────────────────────────
# STATS PRINTER
# ─────────────────────────────────────────────────────────────────────────────
def print_stats():
    print(f"\n{BOLD}{C}{'═'*60}{X}")
    print(f"{BOLD}{G}  SESSION SUMMARY{X}")
    print(f"{C}{'═'*60}{X}")
    print(f"  Packets analysed : {Y}{stats['total_packets']}{X}")
    print(f"  Total alerts     : {R}{stats['alerts']}{X}")
    print()
    print(f"  By Severity:")
    for sev in ["CRITICAL","HIGH","MEDIUM","LOW","INFO"]:
        n = stats["by_severity"].get(sev, 0)
        if n:
            col = SEV[sev]
            bar = "█" * n
            print(f"    {col}{sev:<10}{X}  {bar} ({n})")
    if stats["by_rule"]:
        print(f"\n  Top Triggered Rules:")
        for rid, cnt in sorted(stats["by_rule"].items(), key=lambda x: -x[1])[:5]:
            print(f"    {rid}  →  {cnt} alert(s)")
    if stats["src_ips"]:
        print(f"\n  Top Source IPs:")
        for ip, cnt in sorted(stats["src_ips"].items(), key=lambda x: -x[1])[:5]:
            print(f"    {C}{ip}{X}  →  {cnt} alert(s)")
    print(f"\n  Alert log saved: {G}{log_file}{X}")
    print(f"{C}{'═'*60}{X}\n")

# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────
def main():
    global log_file
    import argparse
    p = argparse.ArgumentParser(description="CodeAlpha Task 4 — NIDS")
    p.add_argument("-i", "--interface", help="Interface (e.g. eth0)")
    p.add_argument("-c", "--count",     type=int, default=0, help="Packet limit (0=unlimited)")
    p.add_argument("-f", "--filter",    default="", help="BPF filter")
    p.add_argument("--log",             default="nids_alerts.log", help="Alert log file")
    p.add_argument("--list",            action="store_true", help="List interfaces")
    args = p.parse_args()

    if args.list:
        if SCAPY_AVAILABLE:
            for i in get_if_list(): print(i)
        else:
            print(f"{R}Install scapy{X}")
        return

    log_file = args.log

    if not SCAPY_AVAILABLE:
        print(f"{R}[!] Scapy is required for NIDS.  pip install scapy{X}")
        sys.exit(1)

    print(BANNER)
    print(f"{G}[*] Interface  : {args.interface or 'ALL'}{X}")
    print(f"{G}[*] Count      : {'∞' if args.count == 0 else args.count}{X}")
    print(f"{G}[*] Filter     : {args.filter or 'none'}{X}")
    print(f"{G}[*] Alert log  : {args.log}{X}")
    print(f"{G}[*] Rules      : {len(RULES)} signatures + anomaly detection{X}")
    print(f"{Y}[!] Ctrl+C to stop\n{X}")

    # Print active rules
    print(f"{BOLD}  ACTIVE DETECTION RULES:{X}")
    for rid, name, sev, *_ in RULES:
        col = SEV[sev]
        print(f"  {col}{SEV_ICON[sev]} {rid}{X}  {name}")
    print()

    try:
        sniff(
            iface=args.interface or None,
            filter=args.filter or None,
            prn=packet_handler,
            count=args.count,
            store=False
        )
    except KeyboardInterrupt:
        pass
    except PermissionError:
        print(f"{R}[!] Run with sudo / root privileges{X}")
    finally:
        print_stats()

if __name__ == "__main__":
    main()
