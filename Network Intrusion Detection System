# ── Severity ──────────────────────────────────────────────────────────────────
SEV = {"CRITICAL":R, "HIGH":M, "MEDIUM":Y, "LOW":B, "INFO":C}
SEV_ICON = {"CRITICAL":"🔴", "HIGH":"🟠", "MEDIUM":"🟡", "LOW":"🔵", "INFO":"⚪"}

def _ports(pkt, dports):
    return TCP in pkt and pkt[TCP].dport in dports

def _payload_contains(pkt, patterns):
    if Raw not in pkt: return False
    payload = pkt[Raw].load
    return any(p in payload for p in patterns)

RULES = [
    # ── Port Scans / Recon ─────────────────────────────────────────────────
    ("NIDS-001", "NULL Scan Detected",    "HIGH",
     "TCP packet with no flags set — classic NULL scan used for OS/port fingerprinting.",
     lambda p: TCP in p and p[TCP].flags == 0),

    ("NIDS-002", "XMAS Scan Detected",   "HIGH",
     "TCP FIN+PSH+URG flags set — XMAS scan used for port/OS fingerprinting.",
     lambda p: TCP in p and p[TCP].flags == 0x29),

    ("NIDS-003", "FIN Scan Detected",    "MEDIUM",
     "TCP FIN-only packet. Used in stealth port scanning.",
     lambda p: TCP in p and p[TCP].flags == 0x01),

    # ── Exploitation Attempts ──────────────────────────────────────────────
    ("NIDS-004", "Possible SQLi in HTTP", "CRITICAL",
     "HTTP payload contains SQL injection keywords.",
     lambda p: _ports(p, {80, 8080, 8000}) and _payload_contains(p, [
         b"' OR ", b"' or ", b"1=1", b"UNION SELECT", b"union select",
