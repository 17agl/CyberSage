# CyberSage Environment Configuration

# OpenAI API Settings (Optional if using Mock Triage mode)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Triage Mode: "auto" (uses OpenAI if key provided, else mock), "real", or "mock"
CYBERSAGE_TRIAGE_MODE=auto

# Server & Dashboard Settings
API_HOST=127.0.0.1
API_PORT=8000
